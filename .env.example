# SPEC-P1.2-STORAGE v0.1 — local database settings for docker-compose.yml (X2 finding B-1).
#
# Copy to .env before running `docker compose up -d`:
#     cp .env.example .env
#
# .env is gitignored. These values are for a LOCAL, LOOPBACK-ONLY development database.
# Production credentials are issued by HashiCorp Vault and never live in a file.

# The application database that 0001_initial.sql is applied to. It is created from
# template0 by scripts/apply-migration.sh so that the migration installs timescaledb into
# schema `extensions` itself; a template1-derived database inherits the image's copy in
# schema `public`, and timescaledb is relocatable=false so it cannot be moved afterwards.
APP_DB=trading

POSTGRES_USER=postgres

# Dev-only credential. Change it locally; it never reaches git.
POSTGRES_PASSWORD=change_me_local_dev_only

# Host port for the loopback bind. 55432 avoids colliding with a local PostgreSQL on 5432.
POSTGRES_PORT=55432
